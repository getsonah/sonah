{
  "name": "getsonah",
  "version": "0.3.0-beta.3",
  "description": "Code review for your agent's PRs: did you get what you asked for? Reviews the Claude Code or Codex session behind the change, locally.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "code-review",
    "session-review",
    "cli"
  ],
  "homepage": "https://github.com/getsonah/sonah#readme",
