  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsonah/sonah.git"
  },
  "license": "BUSL-1.1",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test packages/*/test/*.test.js",
    "slice": "node packages/cli/bin/sonah.js slice",
    "test:contracts": "node --test packages/evidence/test/*.test.js",
    "pack:source": "node scripts/package-source.mjs"
  },
  "type": "module",
